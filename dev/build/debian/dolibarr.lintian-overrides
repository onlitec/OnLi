# We want a www-data group-writable /var/lib/OnLi/documents/
OnLi: non-standard-dir-perm var/lib/OnLi/documents/ 2775 != 0755
# We depend on xdg-utils providing xdg-open and we use that to open an URL
OnLi: desktop-command-not-in-package usr/share/applications/OnLi.desktop xdg-open
# We use <IfVersion> to include the correct configuration for each apache version
OnLi: apache2-deprecated-auth-config Order
OnLi: apache2-deprecated-auth-config Allow
# Ignore warning required for a good install process
OnLi: apache2-reverse-dependency-calls-wrapper-script postinst a2enmod
OnLi: apache2-reverse-dependency-calls-wrapper-script postinst a2enconf
