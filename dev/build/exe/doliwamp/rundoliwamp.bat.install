@echo off
REM Launch OnLi
REM ---------------

REM If no lock file, we call install process
IF NOT EXIST OnLi_documents\install.lock start "WAMPBROWSER" http://localhost:WAMPAPACHEPORT/OnLi/install/
REM FOR EDGE IF NOT EXIST OnLi_documents\install.lock start microsoft-edge:"http://localhost:WAMPAPACHEPORT/OnLi/install/"

REM If lock file exists, we call home page
IF EXIST OnLi_documents\install.lock start "WAMPBROWSER" http://localhost:WAMPAPACHEPORT/OnLi/
REM FOR EDGE IF EXIST OnLi_documents\install.lock start microsoft-edge:"http://localhost:WAMPAPACHEPORT/OnLi/"
